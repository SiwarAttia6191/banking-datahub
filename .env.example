# banking-datahub local stack secrets - template
# copy to .env (gitignored) and fill with your own values; docker compose reads
# .env automatically and the compose defaults stay as ${VAR:-default} fallbacks.

# --- elasticsearch + kibana (browser login + publisher script) ---
ELASTIC_PASSWORD=change-me

# --- postgres serving ---
POSTGRES_PASSWORD=change-me

# --- s3 / seaweedfs (script-side creds) ---
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- dremio (admin account created at first-run; reference only, dremio keeps
# its own user database) ---
DREMIO_ADMIN_USER=change-me
DREMIO_ADMIN_PASSWORD=change-me

# --- airflow (the container pins the admin password to this on every start) ---
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
